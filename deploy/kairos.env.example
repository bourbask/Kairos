# EnvironmentFile pour les services (à placer hors du repo ; chmod 600).
# Format : KEY=VALUE, sans `export` ni guillemets superflus.

# --- Collecteurs (clés optionnelles) ---
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# --- Chemins (absolus recommandés) ---
DATABASE_PATH=/home/USER/kairos/data/kairos.db
BRIEFINGS_DIR=/home/USER/briefings

# --- LLM local ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# --- Calendar ---
# Self-hosted uniquement — jamais un service cloud tiers.
# URL = collection directe (pas le principal) :
#   CALENDAR_URL=http://radicale:5232/UTILISATEUR/CALENDRIER/
CALENDAR_URL=
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
# collection CalDAV de l'agenda travail, optionnelle
CALENDAR_WORK_URL=

# --- Ingestion email (IMAP) ---
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# Expéditeur autorisé — fail-closed : vide = aucune ingestion.
# IMAP_ALLOWED_SENDER=

# --- Notifications (optionnel) ---
# Canal de digest.
# NOTIFY_API_URL=
# NOTIFY_TOKEN=
# NOTIFY_CHANNEL_ID=
# Alertes push (score > 0.9) : service auto-hébergé optionnel déclaré hors dépôt.
# ALERT_URL=
# ALERT_TOPIC=
# ALERT_TOKEN=

# --- Tentacules MCP ---
# Jetons d'accès, obligatoires (refus de démarrer si vides) ; générer : openssl rand -hex 32
MEMOIRE_TOKEN=
AGENDA_TOKEN=
FINANCES_TOKEN=
ALIMENTATION_TOKEN=
# API de finances : adresse privée de l'hôte (jamais publique) et son jeton ; tableau de bord optionnel.
FINANCES_API_URL=
FINANCES_API_TOKEN=
# FINANCES_DASHBOARD_URL=

# Module marchés : jeton, adresse de la source, mots-clés (liste séparée par des virgules)
MARCHES_TOKEN=
MARCHES_API_URL=
MARCHES_KEYWORDS=
# MARCHES_POLL_MINUTES=30

# Module mémoire : jours de conservation des transcriptions déjà résumées (défaut 0 = sans limite ; ex. 90)
# MEMOIRE_TRANSCRIPT_RETENTION_DAYS=90

# Partage du site : jeton d'appel du module par la tête, même valeur que dans docker/partage.env
PARTAGE_TOKEN=

# Module politique (données publiques en lecture seule) : jeton d'appel par la tête
POLITIQUE_TOKEN=

# --- Tête ---
# Jetons de la passerelle (obligatoires : refus de démarrer si vide) ; générer : openssl rand -hex 32
TETE_INBOUND_TOKEN=
TETE_OUTBOUND_URL=
TETE_OUTBOUND_TOKEN=
# Adresse d'écoute (défaut : 0.0.0.0:8090) ; en Docker le port doit rester 8090 (mapping du conteneur), sinon supprimer la ligne
# TETE_BIND=
# API de l'application mobile (optionnelle : sans elle, pas d'API) ; en Docker : 0.0.0.0:8091
# TETE_APP_BIND=
# Adresse de l'API vue par l'appareil, inscrite dans le QR code d'appairage
# TETE_APP_PUBLIC_URL=
