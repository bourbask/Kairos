# Tentacule documents — copier en `documents.env` (hors dépôt) et remplir.
DOCUMENTS_TOKEN=
# Natures (dossiers de premier niveau) jamais exposées : comptées, mais ni
# listées, ni cherchées, ni lues. Casse et accents indifférents.
DOCUMENTS_PRIVATE=
DOCUMENTS_TZ=Europe/Paris
# Pièces de la liste de contrôle sans objet (morceaux de libellé, séparés par des virgules).
DOCUMENTS_NOT_APPLICABLE=
# Écritures en deux temps (aperçu puis confirmation) : déplacer, renommer,
# corbeille datée « _Corbeille/ ». 1 pour autoriser.
DOCUMENTS_WRITE=0
# Période de l'inventaire, en minutes.
DOCUMENTS_SCAN_MINUTES=15

# Lecture des scans et images (reconnaissance de caractères) ; 0 pour couper.
DOCUMENTS_OCR=1
# Modèle local d'extraction des faits (servi par le service ollama).
DOCUMENTS_MODEL=
# Calendrier « Échéances » (collection CalDAV, créée au besoin) ; facultatif.
DOCUMENTS_CALDAV_URL=
DOCUMENTS_CALDAV_USER=
DOCUMENTS_CALDAV_PASS=
