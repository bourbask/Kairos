# Tentacule documents — copier en `documents.env` (hors dépôt) et remplir.
DOCUMENTS_TOKEN=
# Natures (dossiers de premier niveau) jamais exposées : comptées, mais ni
# listées, ni cherchées, ni lues. Casse et accents indifférents.
DOCUMENTS_PRIVATE=
DOCUMENTS_TZ=Europe/Paris
# Période de l'inventaire, en minutes.
DOCUMENTS_SCAN_MINUTES=15
