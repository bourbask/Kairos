# Tentacule médias — copier en `medias.env` (hors dépôt) et remplir.
# Chaque service est facultatif : sans sa variable *_URL, il est ignoré et les
# outils répondent sans lui. Une URL déclarée rend ses secrets obligatoires.

MEDIAS_TOKEN=
MEDIAS_TZ=Europe/Paris
# Espace libre (Go) sous lequel le disque est signalé.
MEDIAS_DISK_MIN_GB=50

# Lecteur média (visionnage, sous-titres, liens).
MEDIAS_PLEX_URL=http://plex:32400
MEDIAS_PLEX_KEY=

# Gestionnaires de séries et de films.
MEDIAS_SONARR_URL=http://sonarr:8989
MEDIAS_SONARR_KEY=
MEDIAS_RADARR_URL=http://radarr:7878
MEDIAS_RADARR_KEY=

# Sous-titres.
MEDIAS_BAZARR_URL=http://bazarr:6767
MEDIAS_BAZARR_KEY=

# Demandes et recherche.
MEDIAS_SEERR_URL=http://seerr:5055
MEDIAS_SEERR_KEY=

# Indexeurs.
MEDIAS_PROWLARR_URL=http://prowlarr:9696
MEDIAS_PROWLARR_KEY=

# Clients de téléchargement. qBittorrent valide l'en-tête Host : utiliser
# l'adresse que ses autres clients emploient (souvent une IP fixe).
MEDIAS_QBIT_URL=
MEDIAS_QBIT_USER=
MEDIAS_QBIT_PASS=
MEDIAS_NZBGET_URL=http://nzbget:6789
MEDIAS_NZBGET_USER=
MEDIAS_NZBGET_PASS=

# Réencodage (sans authentification).
MEDIAS_TDARR_URL=http://tdarr:8265

# Notifications push (ntfy) : fin des demandes, disque presque plein.
# Sans URL, le suivi tourne sans prévenir (état visible avec l'outil `requests`).
MEDIAS_NTFY_URL=
MEDIAS_NTFY_TOPIC=
MEDIAS_NTFY_TOKEN=
# Délai après la sortie avant « en retard » (heures), abandon du suivi (jours),
# période du suivi (minutes).
MEDIAS_LATE_HOURS=72
MEDIAS_DROP_DAYS=60
MEDIAS_TRACK_MINUTES=10

# Calendrier des sorties : adresse de la collection CalDAV dédiée (créée au
# besoin), identifiants du serveur, période de synchronisation (minutes).
MEDIAS_CALDAV_URL=
MEDIAS_CALDAV_USER=
MEDIAS_CALDAV_PASS=
MEDIAS_CALDAV_MINUTES=60

# Musique, livres, lecture, livres audio (facultatifs).
MEDIAS_LIDARR_URL=http://lidarr:8686
MEDIAS_LIDARR_KEY=
# Clé d'API passée en paramètre d'URL.
MEDIAS_LAZYLIBRARIAN_URL=http://lazylibrarian:5299
MEDIAS_LAZYLIBRARIAN_KEY=
# Clé d'API de l'utilisateur (échangée contre un jeton de session).
MEDIAS_KAVITA_URL=http://kavita:5000
MEDIAS_KAVITA_KEY=
# Jeton d'API d'un utilisateur.
MEDIAS_AUDIOBOOKSHELF_URL=http://audiobookshelf:80
MEDIAS_AUDIOBOOKSHELF_KEY=

# Débit réduit des torrents pendant les visios (facultatif) : agenda à lire
# (collection CalDAV, mêmes identifiants que MEDIAS_CALDAV_*), mots-clés
# recherchés dans titre / lieu / description / lien, période en minutes.
MEDIAS_VISIO_CALENDAR_URL=
MEDIAS_VISIO_KEYWORDS=visio,meet.google,teams.microsoft,teams.live,zoom.us,webex,jitsi,whereby,appel vidéo
MEDIAS_VISIO_MINUTES=5
