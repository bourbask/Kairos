# Module de partage : fichier propre au service (hors repo ; chmod 600).
# Ce jeton doit aussi figurer, à l'identique, dans kairos.env (la tête l'utilise pour appeler le module).
# Générer : openssl rand -hex 32
PARTAGE_TOKEN=
# Adresse publique https du site partagé
PARTAGE_PUBLIC_URL=
# Heures de validité d'un lien non ouvert, puis d'une session (défauts 72 et 720)
# PARTAGE_LIEN_HEURES=72
# PARTAGE_SESSION_HEURES=720
