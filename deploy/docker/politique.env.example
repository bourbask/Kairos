# Module Politique : jeton d'accès, seul secret de ce conteneur.
# Même valeur que POLITIQUE_TOKEN dans kairos.env (la tête l'utilise pour appeler le module).
POLITIQUE_TOKEN=
# Réception des signalements : adresse d'écoute publique (vide = désactivée) et plafond journalier.
POLITIQUE_PUBLIC_BIND=
POLITIQUE_SIGNALEMENTS_PLAFOND_JOUR=
