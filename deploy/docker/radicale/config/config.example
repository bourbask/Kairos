# Radicale — config serveur CalDAV.
# Copier ce dossier en config runtime sur l'hôte (gitignoré) :
#   cp config.example config
#   htpasswd -B -c users <utilisateur>     # crée le fichier users (bcrypt)
# Puis pointer un client CalDAV (DAVx5, Thunderbird…) sur l'IP tailnet:5232.

[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections
