# Kairos — configuration d'environnement (exemple)
# Copier en .env et remplir. .env est gitignoré.

# --- Collecteurs (clés optionnelles) ---
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# --- LLM local ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# --- Chemins ---
BRIEFINGS_DIR=
DATABASE_PATH=

# --- Calendar ---
# Self-hosted uniquement — jamais un service cloud tiers.
# CALENDAR_URL=http://CALENDAR_HOST:PORT/
# CALENDAR_USERNAME=
# CALENDAR_PASSWORD=

# --- Ingestion email (IMAP) ---
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# Expéditeur autorisé — fail-closed : vide = aucune ingestion.
# IMAP_ALLOWED_SENDER=

# --- Notifications (optionnel) ---
# NOTIFY_TOKEN=
# NOTIFY_CHANNEL_ID=
# Alerte séparée (score > 0.9) — ntfy self-hosted uniquement :
# NTFY_URL=
# NTFY_TOPIC=
