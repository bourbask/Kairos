# Kairos — Environment configuration
# Copy to .env and fill values. .env is gitignored.

# --- Collectors ---

# Adzuna API (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Jooble API (https://jooble.org/api/about) — optional backup
JOOBLE_API_KEY=

# Remotive — free public API, no key needed

# --- LLM (Ollama) ---

# Primary Ollama endpoint (server)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini

# Secondary Ollama endpoint (optional, for deeper analysis)
# OLLAMA_URL_SECONDARY=http://192.168.x.x:11434
# OLLAMA_MODEL_SECONDARY=mistral-nemo:12b

# --- Paths ---

BRIEFINGS_DIR=
DATABASE_PATH=
