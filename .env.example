# Kairos — Configuration
# Copier ce fichier en .env et remplir les valeurs
# Ne jamais commiter .env (voir .gitignore)

# --- Collecteurs ---

# Adzuna (https://developer.adzuna.com)
# Free tier : 500 req/mois
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Jooble (https://jooble.org/api/about)
# Free tier : 100 req/jour — backup uniquement
JOOBLE_API_KEY=

# Remotive — pas de clé nécessaire (API publique gratuite illimitée)

# --- LLM Ollama ---

# VPS OVH (primaire — H24)
# Modèle : phi3:mini (3.8B Q4, CPU-only, ~5-10 tok/s)
OLLAMA_URL_VPS=http://localhost:11434
OLLAMA_MODEL_VPS=phi3:mini

# PC home (secondaire — disponibilité variable)
# Modèle : mistral-nemo:12b-Q4_K_M (RTX 2070 SUPER 8GB GDDR6, ~30-40 tok/s)
# Laisser vide si pas configuré → fallback automatique sur VPS
# Accès via WireGuard si déploiement VPS : http://10.x.x.x:11434
OLLAMA_URL_PC_HOME=
OLLAMA_MODEL_PC=mistral-nemo:12b-Q4_K_M

# --- Paths ---

# Répertoire de sortie des briefings
# Par défaut : ~/briefings/
BRIEFINGS_DIR=

# Base de données SQLite
# Par défaut : data/kairos.db (relatif au répertoire de l'exécutable)
DATABASE_PATH=
